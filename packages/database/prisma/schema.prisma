generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum AccountRole {
  user
  admin

  @@map("account_role")
}

enum Locale {
  az_AZ @map("az-AZ")
  en
  tr
  ru

  @@map("locale")
}

enum ExplanationStyle {
  clear
  step_by_step
  example_first
  analogy
  concise

  @@map("explanation_style")
}

enum ChallengeLevel {
  adaptive
  gentle
  standard
  demanding

  @@map("challenge_level")
}

enum PathTrack {
  frontend
  backend
  fullstack
  skill

  @@map("path_track")
}

enum PublishStatus {
  draft
  published

  @@map("publish_status")
}

enum BlockType {
  reading
  check_question
  recap

  @@map("block_type")
}

enum ConceptRole {
  primary
  supporting

  @@map("concept_role")
}

enum Difficulty {
  beginner
  easy
  intermediate
  advanced
  expert

  @@map("difficulty")
}

enum EnrollmentStatus {
  active
  paused
  completed

  @@map("enrollment_status")
}

enum ProgressStatus {
  not_started
  in_progress
  completed

  @@map("progress_status")
}

enum TeachingMode {
  explain
  socratic
  practice
  debug
  challenge
  interview
  project
  revision

  @@map("teaching_mode")
}

enum TeachingState {
  created
  prior_check
  objective
  explain
  comprehension_check
  adapt
  exercise
  evaluate
  hint
  raise_difficulty
  summarize
  homework
  completed
  review_completed
  abandoned

  @@map("teaching_state")
}

enum MessageRole {
  student
  teacher
  system

  @@map("message_role")
}

enum EventSource {
  lesson_check
  exercise
  quiz
  code_review
  interview
  homework
  project
  speaking

  @@map("event_source")
}

enum MemoryCategory {
  learning
  skill
  mistake
  project
  interview
  preference

  @@map("memory_category")
}

enum MisconceptionStatus {
  active
  resolved

  @@map("misconception_status")
}

enum HomeworkStatus {
  assigned
  done
  skipped

  @@map("homework_status")
}

enum PlanCode {
  free
  starter
  pro
  premium

  @@map("plan_code")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String     @map("password_hash")
  name            String?    @db.VarChar(80)
  locale          Locale     @default(az_AZ)
  timezone        String     @default("UTC")
  emailVerifiedAt DateTime?   @map("email_verified_at") @db.Timestamptz
  status          UserStatus  @default(active)
  role            AccountRole @default(user)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  studentPreferences      StudentPreferences?
  enrollments             Enrollment[]
  lessonProgress          LessonProgress[]
  learningEvents          LearningEvent[]
  skillMastery            SkillMastery[]
  misconceptions          Misconception[]
  dailyActivity           DailyActivity[]
  teachingSessions        TeachingSession[]
  homeworkAssignments     HomeworkAssignment[]
  memoryItems             MemoryItem[]
  userPlan                UserPlan?
  aiUsage                 AiUsage[]
  exerciseAttempts        ExerciseAttempt[]
  executionClaims         ExerciseExecutionClaim[]
  codeReviews             CodeReview[]
  projectAttempts         ProjectAttempt[]
  projectProgress         ProjectMilestoneProgress[]
  projectReviews          ProjectReview[]
  projectExecutionClaims  ProjectExecutionClaim[]
  projectPlans            ProjectPlan[]
  interviewSessions       InterviewSession[]
  interviewAnswers        InterviewAnswer[]
  interviewExecutionClaims InterviewExecutionClaim[]
  speakingSessions        SpeakingSession[]
  speakingAttempts        SpeakingAttempt[]
  transcriptionUsage      TranscriptionUsage[]
  adminAuditLogs          AdminAuditLog[]
  paymentCustomer         PaymentCustomer?
  subscription            Subscription?
  checkoutSessions        CheckoutSession[]
  skillAssessment         SkillAssessment?

  @@index([createdAt])
  @@index([emailVerifiedAt])
  @@map("users")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model StudentPreferences {
  userId            String           @id @map("user_id") @db.Uuid
  explanationStyle  ExplanationStyle @default(clear) @map("explanation_style")
  challengeLevel    ChallengeLevel   @default(adaptive) @map("challenge_level")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_preferences")
}

model LearningPath {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String        @unique
  title       String
  description String
  track       PathTrack
  status      PublishStatus
  position    Int
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  modules     Module[]
  enrollments Enrollment[]

  @@unique([position])
  @@map("learning_paths")
}

model Module {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pathId      String @map("path_id") @db.Uuid
  slug        String
  title       String
  description String
  position    Int

  path    LearningPath @relation(fields: [pathId], references: [id], onDelete: Restrict)
  lessons Lesson[]

  @@unique([pathId, slug])
  @@unique([pathId, position])
  @@map("modules")
}

model Lesson {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId         String        @map("module_id") @db.Uuid
  slug             String
  title            String
  objective        String
  position         Int
  estimatedMinutes Int           @map("estimated_minutes")
  status           PublishStatus

  module              Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  blocks              LessonBlock[]
  concepts            LessonConcept[]
  progress            LessonProgress[]
  teachingSessions    TeachingSession[]
  homeworkAssignments HomeworkAssignment[]
  exercises           Exercise[]

  @@unique([moduleId, slug])
  @@unique([moduleId, position])
  @@index([status])
  @@map("lessons")
}

model LessonBlock {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId String    @map("lesson_id") @db.Uuid
  position Int
  type     BlockType
  body     Json

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@map("lesson_blocks")
}

model Concept {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug    String @unique
  name    String
  domain  String
  summary String

  prerequisites      ConceptPrerequisite[] @relation("ConceptDependencies")
  requiredBy         ConceptPrerequisite[] @relation("ConceptRequiredBy")
  lessonConcepts     LessonConcept[]
  learningEvents     LearningEvent[]
  projectRequirements ProjectRequirement[]
  projectMilestones  ProjectMilestone[]
  interviewRequirements InterviewRequirement[]
  interviewQuestions InterviewQuestion[]
  speakingQuestions  SpeakingQuestion[]
  skillMastery       SkillMastery[]
  misconceptions     Misconception[]
  memoryItems        MemoryItem[]
  explanationCache   ExplanationCache[]
  exercises          Exercise[]

  @@index([domain])
  @@map("concepts")
}

model ConceptPrerequisite {
  conceptId      String @map("concept_id") @db.Uuid
  prerequisiteId String @map("prerequisite_id") @db.Uuid

  concept      Concept @relation("ConceptDependencies", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite Concept @relation("ConceptRequiredBy", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([conceptId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("concept_prerequisites")
}

model LessonConcept {
  lessonId  String      @map("lesson_id") @db.Uuid
  conceptId String      @map("concept_id") @db.Uuid
  role      ConceptRole

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([lessonId, conceptId])
  @@map("lesson_concepts")
}

model Enrollment {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  pathId      String           @map("path_id") @db.Uuid
  status      EnrollmentStatus @default(active)
  startedAt   DateTime         @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime?        @map("completed_at") @db.Timestamptz

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Restrict)

  @@unique([userId, pathId])
  @@index([userId, status])
  @@map("enrollments")
}

model LessonProgress {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  lessonId         String         @map("lesson_id") @db.Uuid
  status           ProgressStatus @default(not_started)
  startedAt        DateTime?      @map("started_at") @db.Timestamptz
  completedAt      DateTime?      @map("completed_at") @db.Timestamptz
  timeSpentSeconds Int            @default(0) @map("time_spent_seconds")
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId, status])
  @@index([startedAt])
  @@map("lesson_progress")
}

model LearningEvent {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  conceptId String      @map("concept_id") @db.Uuid
  source    EventSource
  sourceId  String?     @map("source_id") @db.Uuid
  evidence  Int         @db.SmallInt
  weight    Decimal     @default(1) @db.Decimal(4, 2)
  metadata  Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  @@index([userId, conceptId, createdAt(sort: Desc)])
  @@map("learning_events")
}

model SkillMastery {
  userId         String   @map("user_id") @db.Uuid
  conceptId      String   @map("concept_id") @db.Uuid
  score          Int      @db.SmallInt
  evidenceCount  Int      @map("evidence_count")
  lastEvidenceAt DateTime @map("last_evidence_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([userId, conceptId])
  @@index([userId, score])
  @@map("skill_mastery")
}

model Misconception {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  conceptId       String               @map("concept_id") @db.Uuid
  code            String
  description     String               @db.VarChar(280)
  status          MisconceptionStatus  @default(active)
  occurrenceCount Int                  @default(1) @map("occurrence_count")
  lastSeenAt      DateTime             @default(now()) @map("last_seen_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  @@unique([userId, conceptId, code])
  @@index([userId, status])
  @@map("misconceptions")
}

model DailyActivity {
  userId           String   @map("user_id") @db.Uuid
  activityDate     DateTime @map("activity_date") @db.Date
  teacherTurns     Int      @default(0) @map("teacher_turns")
  lessonsCompleted Int      @default(0) @map("lessons_completed")
  minutes          Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, activityDate])
  @@index([activityDate])
  @@map("daily_activity")
}

model TeachingSession {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  lessonId       String       @map("lesson_id") @db.Uuid
  mode           TeachingMode
  state          TeachingState
  turnCount         Int       @default(0) @map("turn_count")
  summary           String?
  reviewConceptSlug String?   @map("review_concept_slug")
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz
  endedAt           DateTime? @map("ended_at") @db.Timestamptz

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson               @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  messages TeachingMessage[]
  homework HomeworkAssignment[]
  memory   MemoryItem[]

  @@index([userId, startedAt(sort: Desc)])
  @@map("teaching_sessions")
}

model TeachingMessage {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String       @map("session_id") @db.Uuid
  clientTurnId String?      @map("client_turn_id")
  role         MessageRole
  speech       String
  payload      Json?
  model        String?
  inputTokens  Int?         @map("input_tokens")
  outputTokens Int?         @map("output_tokens")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  session TeachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientTurnId])
  @@index([sessionId, createdAt])
  @@map("teaching_messages")
}

model HomeworkAssignment {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  sessionId   String         @map("session_id") @db.Uuid
  lessonId    String         @map("lesson_id") @db.Uuid
  prompt      String
  status      HomeworkStatus @default(assigned)
  dueAt       DateTime       @map("due_at") @db.Timestamptz
  completedAt DateTime?      @map("completed_at") @db.Timestamptz

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session TeachingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  lesson  Lesson          @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@index([userId, status, dueAt])
  @@map("homework_assignments")
}

model MemoryItem {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  category   MemoryCategory
  conceptId  String?        @map("concept_id") @db.Uuid
  content    String         @db.VarChar(280)
  importance Int            @db.SmallInt
  sessionId  String?        @map("session_id") @db.Uuid
  expiresAt  DateTime?      @map("expires_at") @db.Timestamptz
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept?         @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  session TeachingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, category, createdAt(sort: Desc)])
  @@map("memory_items")
}

model ExplanationCache {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conceptId  String           @map("concept_id") @db.Uuid
  locale     Locale
  difficulty Difficulty
  style      ExplanationStyle
  speech     String
  model      String
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, locale, difficulty, style])
  @@map("explanation_cache")
}

model Plan {
  code                PlanCode @id
  name                String
  description         String   @default("")
  monthlyPriceMinor   Int      @map("monthly_price_minor")
  currency            String   @default("AZN") @db.Char(3)
  dailyTeacherTurns   Int      @map("daily_teacher_turns")
  monthlyTeacherTurns Int      @map("monthly_teacher_turns")
  dailyStrongCalls    Int      @map("daily_strong_calls")
  entitlements        Json     @default("{}")
  active              Boolean  @default(true)

  userPlans UserPlan[]
  prices    PlanPrice[]

  @@map("plans")
}

enum SubscriptionStatus {
  incomplete
  trialing
  active
  past_due
  canceled
  expired

  @@map("subscription_status")
}

model PlanPrice {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planCode         PlanCode @map("plan_code")
  slug             String   @unique
  currency         String   @db.Char(3)
  amountMinor      Int      @map("amount_minor")
  billingInterval  String   @map("billing_interval")
  providerPriceId  String?  @unique @map("provider_price_id")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  plan                 Plan           @relation(fields: [planCode], references: [code], onDelete: Restrict)
  subscriptions        Subscription[] @relation("SubscriptionPrice")
  scheduledFor         Subscription[] @relation("ScheduledPrice")
  checkoutSessions     CheckoutSession[]

  @@map("plan_prices")
}

model PaymentCustomer {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  provider           String
  providerCustomerId String   @map("provider_customer_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerCustomerId])
  @@map("payment_customers")
}

model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String             @unique @map("user_id") @db.Uuid
  provider               String
  providerCustomerId     String             @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  priceId                String             @map("price_id") @db.Uuid
  status                 SubscriptionStatus
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at") @db.Timestamptz
  scheduledPriceId       String?            @map("scheduled_price_id") @db.Uuid
  lastEventAt            DateTime?          @map("last_event_at") @db.Timestamptz
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  price          PlanPrice  @relation("SubscriptionPrice", fields: [priceId], references: [id], onDelete: Restrict)
  scheduledPrice PlanPrice? @relation("ScheduledPrice", fields: [scheduledPriceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("subscriptions")
}

model CheckoutSession {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  clientCheckoutId   String   @map("client_checkout_id") @db.Uuid
  priceId            String   @map("price_id") @db.Uuid
  provider           String
  providerCheckoutId String?  @unique @map("provider_checkout_id")
  checkoutUrl        String   @default("") @map("checkout_url")
  status             String
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  price PlanPrice @relation(fields: [priceId], references: [id], onDelete: Restrict)

  @@unique([userId, clientCheckoutId])
  @@index([status, createdAt])
  @@map("checkout_sessions")
}

model PaymentEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  occurredAt      DateTime  @map("occurred_at") @db.Timestamptz
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt     DateTime? @map("processed_at") @db.Timestamptz
  status          String

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("payment_events")
}

model UserPlan {
  userId      String   @id @map("user_id") @db.Uuid
  planCode    PlanCode @map("plan_code")
  status      String   @default("active")
  periodStart DateTime @map("period_start") @db.Timestamptz
  periodEnd   DateTime @map("period_end") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planCode], references: [code], onDelete: Restrict)

  @@index([planCode])
  @@map("user_plans")
}

model AiUsage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  taskType      String   @map("task_type")
  provider      String
  model         String
  inputTokens   Int      @map("input_tokens")
  outputTokens  Int      @map("output_tokens")
