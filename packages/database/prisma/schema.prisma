  claims          InterviewExecutionClaim[]

  @@index([userId, status])
  @@index([userId, startedAt])
  @@map("interview_sessions")
}

model InterviewAnswer {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
