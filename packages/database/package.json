{
  "name": "@platform/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "node dist/seed-cli.js"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.16.0",
    "dotenv": "18.0.5",
    "eslint": "catalog:",
    "prisma": "7.10.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@platform/config": "workspace:*",
    "@platform/curriculum": "workspace:*",
    "@platform/execution": "workspace:*",
    "@platform/types": "workspace:*",
    "@platform/validation": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  }
}
