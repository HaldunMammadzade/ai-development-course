# Copy to .env at the repository root before starting the API.
# NODE_ENV is required. PORT and DATABASE_URL are required when NODE_ENV=production.
# Development and test use port 3001 when PORT is unset.
# Identity operations need DATABASE_URL. Health does not.
# This URL matches docker-compose.yml. The password is for local Postgres only.

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform

# The web server proxies /api to this origin. The default is http://127.0.0.1:3001.
# API_INTERNAL_URL=http://127.0.0.1:3001

# API process only. Do not put these in the web app.
# Leave them unset for local development and CI. A teach call fails until all three required values are set.
# AI_PROVIDER=openai-compatible
# AI_TEACH_MODEL=
# AI_REVIEW_MODEL=
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MAX_INPUT_CHARS=12000
# AI_MAX_OUTPUT_TOKENS=800

# Speech-to-text. Leave unset to disable transcription. The browser never sees these values.
# AI_TRANSCRIPTION_PROVIDER=
# AI_TRANSCRIPTION_MODEL=
# AI_TRANSCRIPTION_API_KEY=
# AI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1

# JavaScript exercise execution. The API does not run student code.
# Development defaults to a loopback runner at http://127.0.0.1:3002.
# Start apps/runner only when Docker is available, after building platform-js-sandbox:12.
# EXECUTION_MODE=docker
# EXECUTION_RUNNER_URL=http://127.0.0.1:3002
# EXECUTION_RUNNER_TOKEN=local-development-runner
# Tests use EXECUTION_MODE=fake and do not start Docker. Fake mode is not a sandbox.

# Payments. API process only. Never expose these to the web app or the browser.
# Leave them unset until a real HTTPS provider is configured. Unset means checkout is unavailable.
# PAYMENT_PROVIDER=fake is rejected when NODE_ENV=production.
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_BASE_URL=https://payments.example.test
# PAYMENT_TIMEOUT_MS=10000

# Email. API process only. Never expose these to the web app or the browser.
# Leave them unset in development and test. Unset means mail is not sent and accounts stay unverified
# until a real provider is configured. EMAIL_PROVIDER=fake is rejected when NODE_ENV=production.
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_BASE_URL=https://mail.example.test
# EMAIL_FROM_ADDRESS=noreply@example.test
# EMAIL_FROM_NAME=Müəllim
# EMAIL_TIMEOUT_MS=10000
# APP_PUBLIC_URL=http://127.0.0.1:3000

# Optional explicit browser origin for credentialed CORS. Leave unset when the web app proxies /api.
# Production requires https. A wildcard is rejected.
# WEB_ORIGIN=https://app.example.test
